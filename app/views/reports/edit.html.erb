<h1>Report編集</h1>

<%= form_with model: @report, local: true do |form| %>
  <div class="field">
    <%= form.label :title, "タイトル" %><br>
    <%= form.text_field :title %>
  </div>

  <div class="field">
    <%= form.label :body, "本文" %><br>
    <%= form.text_area :body %>
  </div>

  <div class="actions">
    <%= form.submit "更新する" %>
  </div>
<% end %>

<p>
  <%= link_to "詳細へ戻る", @report %>
</p>
